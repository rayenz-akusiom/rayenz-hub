{
  "name": "rayenz-hub",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:coverage:full": "vitest run --config vitest.coverage.full.config.ts --coverage",
    "test:web:coverage": "vitest run --config vitest.web.config.ts --coverage",
    "dev:web": "npm run dev -w @rayenz-hub/web",
    "dev:mcp": "npm run dev -w @rayenz-hub/mcp",
    "start:mcp": "npm run start -w @rayenz-hub/mcp",
    "dev:dashboard": "node tools/dev-dashboard/server.mjs",
    "build:web": "npm run build -w @rayenz-hub/web",
    "publish:hub": "tsx scripts/publish-hub.ts",
    "test:unit:watch": "vitest tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "extract:suggestion-fixture": "node tests/scripts/extract-suggestion-fixture.mjs",
    "deploy:hub": "git subtree push --prefix=rayenz-hub hub-prod main",
    "init:local-db": "node scripts/create-local-hub-table.mjs",
    "start:dynamodb:persist": "node tools/dev-dashboard/cli.mjs start dynamodb",
    "start:minio:persist": "node tools/dev-dashboard/cli.mjs start minio",
    "stop:dynamodb": "node tools/dev-dashboard/cli.mjs stop dynamodb",
    "stop:minio": "node tools/dev-dashboard/cli.mjs stop minio",
    "build:api": "sam build --template-file infra/template.yaml --build-in-source && node scripts/copy-api-lambda-assets.mjs",
    "setup:local-cognito": "tsx scripts/setup-local-cognito.ts",
    "start:api": "npm run build:api && node scripts/merge-local-env.mjs && node scripts/start-local-api.mjs",
    "deploy:cognito": "tsx scripts/deploy-cognito.ts",
    "deploy:api": "npm run build:api && tsx scripts/deploy-api.ts",
    "deploy:api:guided": "npm run build:api && sam deploy --guided --config-file infra/samconfig.toml",
    "test:api:deployed": "vitest run tests/api/deployed.contract.test.ts",
    "migrate:user-partition": "tsx scripts/migrate-user-partition.ts",
    "provision:owner": "tsx scripts/provision-owner-rayenz.ts",
    "sync:owner-local-to-prod": "tsx scripts/sync-owner-local-to-prod.ts",
    "build:release-catalog": "node scripts/build-scryfall-release-catalog.mjs",
    "seed:local-library": "tsx scripts/seed-local-library.ts",
    "stage:sl-limitless": "tsx scripts/stage-sl-limitless-swaps.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.12",
    "happy-dom": "^17.4.4",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
